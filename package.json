{
  "name": "sidelore",
  "version": "0.2.0",
  "private": true,
  "description": "A decentralized research network for unfinished work, shared evidence, and explicit publication permission.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run build:web && node --test dist/packages/*/test/*.test.js dist/apps/*/test/*.test.js",
    "validate": "npm run build && node dist/packages/schema/src/validate-fixtures.js",
    "node": "npm run build && node dist/apps/node/src/run.js",
    "cli": "npm run build && node dist/apps/cli/src/main.js",
    "dev": "npm run node",
    "web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "web:static": "npm run build:web && python3 -m http.server 8000 --directory dist/web",
    "build:desktop": "npm run build && npm run build:web && node scripts/desktop-build.mjs",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && electron-builder --config electron-builder.yml",
    "test:scale": "npm run build && node scripts/scale-sync.mjs",
    "test:desktop": "npm run build:desktop && node scripts/desktop-e2e.mjs",
    "audit:source": "node scripts/audit-source.mjs",
    "test:source": "node --test scripts/audit-source.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/libsodium-wrappers-sumo": "0.7.8",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.0",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/dcutr": "^3.0.28",
    "@libp2p/gossipsub": "^17.1.2",
    "@libp2p/identify": "4.1.14",
    "@libp2p/kad-dht": "^16.4.5",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/ping": "^3.1.13",
    "@libp2p/tcp": "11.0.28",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@multiformats/multiaddr": "13.0.3",
    "fastify": "5.12.5",
    "idb": "8.0.3",
    "it-length-prefixed": "11.0.1",
    "it-pipe": "3.0.1",
    "libp2p": "3.3.11",
    "libsodium-wrappers-sumo": "0.8.4",
    "multiformats": "^14.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uint8arrays": "6.1.1",
    "zod": "4.6.5"
  },
  "main": "dist/apps/desktop/src/main.js",
  "author": "3072"
}
